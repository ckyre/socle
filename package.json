{
  "name": "socle",
  "version": "1.3.0",
  "description": "Code commun aux fronts de la suite : CSS (Tailwind 4 : jetons, base, coquille mobile, composants), notifications push (module navigateur, service worker, greffon Vite).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": [
    "css/*.css",
    "js/*.js",
    "js/*.d.ts"
  ],
  "style": "css/suite.css",
  "exports": {
    ".": {
      "style": "./css/suite.css",
      "default": "./css/suite.css"
    },
    "./suite.css": "./css/suite.css",
    "./kit.css": "./css/kit.css",
    "./socle.css": "./css/socle.css",
    "./jetons.css": "./css/jetons.css",
    "./base.css": "./css/base.css",
    "./mise-en-page.css": "./css/mise-en-page.css",
    "./composants.css": "./css/composants.css",
    "./utilitaires.css": "./css/utilitaires.css",
    "./push": {
      "types": "./js/push.d.ts",
      "default": "./js/push.js"
    },
    "./vite": {
      "types": "./js/vite.d.ts",
      "default": "./js/vite.js"
    },
    "./sw.js": "./js/sw.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
